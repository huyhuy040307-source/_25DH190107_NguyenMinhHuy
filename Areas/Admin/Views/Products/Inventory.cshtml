
@{
    ViewBag.Title = "Quản lý kho hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var inStock = ViewBag.InStockProducts as List<_25DH190025_NguyenHuynhHongQuan.Models.Product> ?? new List<_25DH190025_NguyenHuynhHongQuan.Models.Product>();
    var outOfStock = ViewBag.OutOfStockProducts as List<_25DH190025_NguyenHuynhHongQuan.Models.Product> ?? new List<_25DH190025_NguyenHuynhHongQuan.Models.Product>();
}

<h2 class="bg-success text-white p-2" style="border-radius: 4px;">QUẢN LÝ KHO HÀNG (TỒN KHO & CẦN NHẬP)</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-2">@TempData["SuccessMessage"]</div>
}

<div class="mt-3 mb-4">
    <h4 class="bg-danger text-white p-2" style="border-radius: 4px;">
        1. DANH SÁCH HÀNG CẦN NHẬP (Số lượng tồn = 0) — Có @outOfStock.Count sản phẩm
    </h4>
    @Html.Partial("_PVInventoryTable", outOfStock)
</div>

<div class="mt-4">
    <h4 class="bg-success text-white p-2" style="border-radius: 4px;">
        2. DANH SÁCH HÀNG TỒN TRONG KHO (Số lượng tồn > 0) — Có @inStock.Count sản phẩm
    </h4>
    @Html.Partial("_PVInventoryTable", inStock)
</div>

<p class="mt-3">
    @Html.ActionLink("Quay lại danh sách sản phẩm", "Index", "Products", new { area = "Admin" }, new { @class = "btn btn-secondary" })
</p>
