@model _25DH190025_NguyenHuynhHongQuan.Models.User

@{
    var customer = Model != null && Model.Customers != null ? Model.Customers.FirstOrDefault() : null;
    string custName = customer != null ? customer.CustomerName : "";
    string custPhone = customer != null ? customer.CustomerPhone : "";
    string custEmail = customer != null ? customer.CustomerEmail : "";
    string custAddress = customer != null ? customer.CustomerAddress : "";
    bool isEdit = ViewBag.IsEdit == true;
}

<style>
    .user-grid-table {
        width: 100%;
        table-layout: fixed;
    }
    .user-grid-table td {
        width: 33.33%;
        padding: 14px;
        vertical-align: top;
        background-color: #f8f9fa;
    }
    .user-grid-table .field-label {
        display: block;
        font-weight: 600;
        color: #198754;
        margin-bottom: 6px;
    }
    .user-grid-table .form-control {
        width: 100%;
        max-width: 100%;
    }
</style>

<table class="table table-bordered user-grid-table">
    <tr>
        <td>
            <label class="field-label">Tên đăng nhập</label>
            @Html.TextBoxFor(model => model.Username, new { @class = "form-control", required = "required", placeholder = "Nhập tên tài khoản..." })
            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
        </td>
        <td>
            <label class="field-label">Mật khẩu</label>
            @Html.TextBoxFor(model => model.Password, new { @class = "form-control", required = "required", placeholder = "Nhập mật khẩu..." })
            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
        </td>
        <td>
            <label class="field-label">Vai trò phân quyền</label>
            @Html.DropDownListFor(model => model.UserRole, (SelectList)ViewBag.RoleList, new { @class = "form-control fw-bold" })
            <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
                • <strong>Admin</strong>: Toàn quyền quản trị hệ thống (Sản phẩm, Đơn hàng, v.v.)<br />
                • <strong>Customer</strong>: Khách hàng mua sắm, xem đơn hàng cá nhân
            </small>
            @Html.ValidationMessageFor(model => model.UserRole, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <td>
            <label class="field-label">Họ tên khách hàng</label>
            <input type="text" name="CustomerName" class="form-control" value="@custName" placeholder="Họ và tên..." />
        </td>
        <td>
            <label class="field-label">Số điện thoại</label>
            <input type="text" name="CustomerPhone" class="form-control" value="@custPhone" placeholder="Số điện thoại..." />
        </td>
        <td>
            <label class="field-label">Email</label>
            <input type="email" name="CustomerEmail" class="form-control" value="@custEmail" placeholder="name@example.com" />
        </td>
    </tr>
    <tr>
        <td colspan="3">
            <label class="field-label">Địa chỉ</label>
            <input type="text" name="CustomerAddress" class="form-control" value="@custAddress" placeholder="Địa chỉ liên hệ..." />
        </td>
    </tr>
    <tr>
        <td colspan="3" class="text-center py-3" style="text-align: center;">
            <input type="submit" value="Lưu tài khoản" class="btn btn-primary px-4" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </td>
    </tr>
</table>
