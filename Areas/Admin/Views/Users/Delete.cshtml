@model _25DH190025_NguyenHuynhHongQuan.Models.User

@{
    ViewBag.Title = "Xóa tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var cust = Model != null && Model.Customers != null ? Model.Customers.FirstOrDefault() : null;
}

<h2 class="bg-danger text-white p-2" style="border-radius: 4px;">XÓA TÀI KHOẢN</h2>

<div class="alert alert-warning mt-3">
    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa tài khoản <strong>@Model.Username</strong> (@(cust != null ? cust.CustomerName : "")) không? Hành động này không thể hoàn tác!
</div>

<table class="table table-bordered" style="max-width: 600px;">
    <tr>
        <th class="bg-light" style="width: 35%;">Tên đăng nhập</th>
        <td><strong>@Model.Username</strong></td>
    </tr>
    <tr>
        <th class="bg-light">Họ tên khách hàng</th>
        <td>@(cust != null ? cust.CustomerName : "—")</td>
    </tr>
    <tr>
        <th class="bg-light">Số điện thoại</th>
        <td>@(cust != null ? cust.CustomerPhone : "—")</td>
    </tr>
    <tr>
        <th class="bg-light">Vai trò</th>
        <td>
            @{
                string role = (Model.UserRole ?? "").Trim();
                bool isAdmin = role.Equals("Admin", StringComparison.OrdinalIgnoreCase) || role.Equals("A", StringComparison.OrdinalIgnoreCase);
            }
            @if (isAdmin)
            {
                <span class="badge bg-danger p-2">👑 Quản trị viên (Admin)</span>
            }
            else
            {
                <span class="badge bg-primary p-2">🛒 Khách hàng (Customer)</span>
            }
        </td>
    </tr>
</table>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="mt-3">
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
        @Html.ActionLink("Hủy bỏ, quay lại", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
}
