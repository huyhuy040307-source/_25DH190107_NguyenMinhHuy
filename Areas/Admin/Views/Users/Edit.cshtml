@model _25DH190107_NguyenMinhHuy.Models.User

@{
    ViewBag.Title = "Cập nhật tài khoản";
    ViewBag.IsEdit = true;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white p-2" style="border-radius: 4px;">CẬP NHẬT TÀI KHOẢN</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal mt-3">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <input type="hidden" name="originalUsername" value="@Model.Username" />
        @Html.Partial("PVCreateEditUser", Model)
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
