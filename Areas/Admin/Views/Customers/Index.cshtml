@model IEnumerable<_25DH190107_NguyenMinhHuy.Models.Customer>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white p-2" style="border-radius: 4px;">DANH SÁCH KHÁCH HÀNG</h2>

<div class="row mb-3 mt-3">
    <div class="col-md-6">
        @using (Html.BeginForm("Index", "Customers", FormMethod.Get, new { @class = "d-flex gap-2" }))
        {
            <input type="text" name="searchTerm" class="form-control" placeholder="Tìm theo tên khách hàng, SĐT, email, tài khoản..." value="@ViewBag.SearchTerm" />
            <button type="submit" class="btn btn-primary text-nowrap">Tìm kiếm</button>
            if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="@Url.Action("Index", "Customers")" class="btn btn-outline-secondary text-nowrap">Xóa tìm</a>
            }
        }
    </div>
</div>

<table class="table table-bordered table-striped bg-info align-middle">
    <thead class="bg-success text-white">
        <tr>
            <th>Mã KH</th>
            <th>Họ tên khách hàng</th>
            <th>Tên đăng nhập</th>
            <th>Số điện thoại</th>
            <th>Email</th>
            <th>Địa chỉ</th>
            <th class="text-center">Số đơn hàng</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>#@item.CustomerID</td>
                    <td><strong>@item.CustomerName</strong></td>
                    <td>@item.Username</td>
                    <td>@item.CustomerPhone</td>
                    <td>@item.CustomerEmail</td>
                    <td>@item.CustomerAddress</td>
                    <td class="text-center">
                        <span class="badge bg-primary">@(item.Orders != null ? item.Orders.Count() : 0)</span>
                    </td>
                    <td class="text-center">
                        @Html.ActionLink("Chi tiết & Đơn hàng", "Details", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-sm" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center py-3">Không tìm thấy khách hàng nào.</td>
            </tr>
        }
    </tbody>
</table>
