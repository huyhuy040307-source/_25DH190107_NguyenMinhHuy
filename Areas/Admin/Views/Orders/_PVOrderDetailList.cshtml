
@model IEnumerable<_25DH190025_NguyenHuynhHongQuan.Models.OrderDetail>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
        <thead class="table-light">
            <tr style="border-bottom: 2px solid #dee2e6;">
                <th colspan="2" style="padding: 10px 12px;">Sản phẩm</th>
                <th class="text-center" style="width: 80px; padding: 10px 8px;">Số lượng</th>
                <th class="text-end" style="width: 120px; padding: 10px 8px;">Đơn giá</th>
                <th class="text-end" style="width: 130px; padding: 10px 12px;">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td style="width: 75px; padding: 8px 12px;">
                            @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ProductImage))
                            {
                                <img src="@item.Product.ProductImage" style="height: 70px; width: 60px; object-fit: contain; border-radius: 4px; border: 1px solid #eee;" />
                            }
                        </td>
                        <td style="padding: 8px 12px;">
                            <strong class="text-dark">@(item.Product != null ? item.Product.ProductName : "Sản phẩm #" + item.ProductID)</strong>
                        </td>
                        <td class="text-center fw-semibold" style="padding: 8px 8px;">@item.Quantity</td>
                        <td class="text-end" style="padding: 8px 8px;">@item.UnitPrice.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-danger" style="padding: 8px 12px;">@((item.Quantity * item.UnitPrice).ToString("N0")) đ</td>
                    </tr>
                }
            }
        </tbody>
        @if (Model != null && Model.Any())
        {
            <tfoot class="table-light">
                <tr>
                    <th colspan="4" class="text-end" style="padding: 10px 12px;">Tổng giá trị sản phẩm:</th>
                    <th class="text-end text-danger fw-bold fs-6" style="padding: 10px 12px;">
                        @(Model.Sum(x => x.Quantity * x.UnitPrice).ToString("N0")) đ
                    </th>
                </tr>
            </tfoot>
        }
    </table>
</div>
