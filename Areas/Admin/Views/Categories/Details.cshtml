@model _25DH190107_NguyenMinhHuy.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white p-2" style="border-radius: 4px;">THÔNG TIN CHI TIẾT DANH MỤC</h2>

<div class="card p-3 mb-4 mt-3" style="border: 1px solid #ddd; border-radius: 6px;">
    <p><strong>Mã danh mục:</strong> #@Model.CategoryID</p>
    <p><strong>Tên danh mục:</strong> <span class="text-success fw-bold">@Model.CategoryName</span></p>
    <p><strong>Tổng số hàng hóa thuộc danh mục:</strong> @(Model.Products != null ? Model.Products.Count() : 0) sản phẩm</p>
    <div>
        @Html.ActionLink("Cập nhật", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary btn-sm" })
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary btn-sm ms-2" })
    </div>
</div>

<h4 class="bg-info p-2" style="border-radius: 4px;">DANH SÁCH SẢN PHẨM THUỘC DANH MỤC "@Model.CategoryName.ToUpper()"</h4>

@if (Model.Products != null && Model.Products.Any())
{
    <table class="table table-bordered table-striped">
        <thead class="bg-success text-white">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng tồn</th>
                <th>Đã bán</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in Model.Products)
            {
                <tr>
                    <td><img src="@prod.ProductImage" style="height: 60px; max-width: 60px; object-fit: contain;" /></td>
                    <td>@prod.ProductName</td>
                    <td class="text-danger fw-bold">@prod.ProductPrice.ToString("N0") đ</td>
                    <td>@prod.Quantity</td>
                    <td>@prod.SoldQuantity</td>
                    <td>
                        @Html.ActionLink("Chi tiết SP", "Details", "Products", new { area = "Admin", id = prod.ProductID }, new { @class = "btn btn-info btn-sm text-white" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">Chưa có sản phẩm nào thuộc danh mục này.</div>
}
