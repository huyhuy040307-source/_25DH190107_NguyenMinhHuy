@model _25DH190107_NguyenMinhHuy.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA DANH MỤC</h2>

<h3 class="bg-danger">Bạn có chắc muốn xóa danh mục này không?</h3>
<div>
    <hr />
   @using (Html.BeginForm())
   {
        @Html.AntiForgeryToken()
<div class="form-horizontal">
    <div class="form-group">
        <div class="control-lable col-md-2">Tên danh mục</div>
        <div class="col-md-10">
            @Html.DisplayFor(model => model.CategoryName)
        </div>

        <div class="col-md-offset-2 col-md-10">

            <div class="form-actions no-color">
                <input type="submit" value="Xóa" class="btn btn-primary" />
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
            </div>
        </div>
    </div>
</div>

   }
</div>