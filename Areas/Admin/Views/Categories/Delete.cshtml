@model _25DH190025_NguyenHuynhHongQuan.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int prodCount = Model.Products != null ? Model.Products.Count() : 0;
}

<h2 class="bg-success text-white p-2">XÓA DANH MỤC</h2>

@if (prodCount > 0)
{
    <div class="alert alert-danger mt-3">
        <strong>Cảnh báo ràng buộc dữ liệu:</strong> Danh mục <strong>@Model.CategoryName</strong> hiện đang có <strong>@prodCount sản phẩm</strong>. Bạn không thể xóa danh mục này khi vẫn còn sản phẩm bên trong!
    </div>
}
else
{
    <h4 class="alert alert-warning mt-3">Bạn có chắc muốn xóa danh mục "@Model.CategoryName" không?</h4>
}

<div>
    <hr />
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="form-group mb-3">
                <label class="fw-bold">Tên danh mục:</label> @Html.DisplayFor(model => model.CategoryName)
            </div>
            <div class="form-actions no-color">
                @if (prodCount == 0)
                {
                    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
                }
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    }
</div>
