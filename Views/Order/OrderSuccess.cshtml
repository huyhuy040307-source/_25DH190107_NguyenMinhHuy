
@model _25DH190107_NguyenMinhHuy.Models.Order

@{
    ViewBag.Title = "OrderSuccess";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2 class="text-center text-success">XÁC NHẬN ĐƠN HÀNG</h2>

    <div class="alert alert-success text-center">
        <h4>Đặt hàng thành công!</h4>
        <p>Cảm ơn bạn đã mua hàng tại cửa hàng của chúng tôi.</p>
    </div>

    <h3>Thông tin đơn hàng</h3>

    <div class="well">
        <p><strong>Mã đơn hàng:</strong> @Model.OrderID</p>
        <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate</p>
        <p><strong>Tổng số tiền:</strong> @Model.TotalAmount</p>
        <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
        <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
        <p><strong>Phương thức giao hàng:</strong> @Model.ShippingMethod</p>
        <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
    </div>

    <h3>Chi tiết đơn hàng</h3>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Tổng giá</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.Product.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice</td>
                    <td>@item.TotalPrice</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center">
        <a href="@Url.Action("Index", "Home")"
           class="btn btn-primary">
            Tiếp tục mua sắm
        </a>
    </div>
</div>
