@model _25DH190107_NguyenMinhHuy.Models.Customer

@{
    ViewBag.Title = "Hồ sơ khách hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-3">
    <div class="card shadow-sm mx-auto" style="max-width: 650px; border-radius: 12px; padding: 30px;">
        <h3 class="text-center text-success fw-bold mb-3">HỒ SƠ KHÁCH HÀNG</h3>
        <hr />

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">⚠️ @TempData["ErrorMessage"]</div>
        }

        @using (Html.BeginForm("ProfileInfo", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CustomerID)

            <div class="mb-3 row">
                <label class="col-sm-4 col-form-label fw-bold">Tên đăng nhập</label>
                <div class="col-sm-8">
                    <input type="text" name="newUsername" class="form-control" value="@Model.Username" required="required" placeholder="Nhập tên đăng nhập..." />
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-4 col-form-label fw-bold">Họ và tên</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", required = "required" })
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-4 col-form-label fw-bold">Số điện thoại</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", required = "required" })
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-4 col-form-label fw-bold">Email</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email" })
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-4 col-form-label fw-bold">Địa chỉ mặc định</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control" })
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-4 col-form-label fw-bold">Đổi mật khẩu mới</label>
                <div class="col-sm-8">
                    <input type="password" name="NewPassword" class="form-control" placeholder="Bỏ trống nếu không đổi mật khẩu..." />
                </div>
            </div>

            <div class="text-center mt-4 d-flex justify-content-center gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary px-4 fw-semibold">Lưu thay đổi</button>
                <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-info fw-semibold">Lịch sử mua hàng</a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary fw-semibold">Quay lại trang chủ</a>
            </div>
        }
    </div>
</div>
