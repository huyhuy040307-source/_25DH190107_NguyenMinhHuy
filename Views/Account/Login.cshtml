@model _25DH190025_NguyenHuynhHongQuan.Models.ViewModel.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-card {
        max-width: 540px;
        margin: 30px auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
        padding: 35px;
        border: 1px solid #e9ecef;
    }
    .auth-card .form-control {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box;
    }
    .auth-label {
        font-weight: 600;
        color: #333333;
    }
</style>

<div class="container py-3">
    <div class="auth-card">
        <h3 class="fw-bold mb-3 text-center text-success">ĐĂNG NHẬP</h3>
        <hr class="mb-4" />

        @if (TempData["Notice"] != null)
        {
            <div class="alert alert-success py-2 mb-3 small">
                ℹ️ @TempData["Notice"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 mb-3 small">
                ⚠️ @ViewBag.Error
            </div>
        }

        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

        @using (Html.BeginForm("Login", "Account", new { area = "" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="row mb-3 align-items-center">
                <label class="col-sm-4 col-form-label auth-label">Tên đăng nhập</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Nhập tên đăng nhập...", required = "required" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="row mb-3 align-items-center">
                <label class="col-sm-4 col-form-label auth-label">Mật khẩu</label>
                <div class="col-sm-8">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu...", required = "required" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-sm-8 offset-sm-4 d-flex align-items-center">
                    <input type="submit" value="Đăng nhập" class="btn btn-primary px-4 fw-semibold" />
                    @Html.ActionLink("Chưa có tài khoản? Đăng ký ngay", "Register", "Account", new { area = "" }, new { @class = "btn btn-outline-secondary ms-2 small" })
                </div>
            </div>
        }
    </div>
</div>
