@model _25DH190025_NguyenHuynhHongQuan.Models.ViewModel.Cart
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="~/Content/myStyle/Cart.css" rel="stylesheet" />
}
<script language="JavaScript">
    function cartUpdateQuantity(id, newQuantity) {
        if (newQuantity < 1) return;
        const form = document.createElement('form');
        form.method = 'post';
        form.action = '@Url.Action("UpdateQuantity", "Cart")';

        const idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = 'id';
        idInput.value = id;
        form.appendChild(idInput);

        const quantityInput = document.createElement('input');
        quantityInput.type = 'hidden';
        quantityInput.name = 'quantity';
        quantityInput.value = newQuantity;
        form.appendChild(quantityInput);

        document.body.appendChild(form);
        form.submit();
    }
</script>

<h2 style="color: #4A2E18; font-weight: 700;">GIỎ HÀNG (@Model.Items.Sum(i => i.Quantity) sản phẩm)</h2>

@if (TempData["CartError"] != null)
{
    <div class="alert alert-warning">⚠️ @TempData["CartError"]</div>
}

<div class="shoppingcart">
    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">
            Bạn chưa có sản phẩm nào trong giỏ hàng.
        </div>
    }
    else
    {
        <div class="col-md-8 cart-section">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th colspan="2">Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                        <th title="Xóa tất cả mặt hàng trong giỏ" class="text-center" style="width: 50px;">
                            <a href="@Url.Action("ClearCart", "Cart", null)" class="btn btn-outline-danger btn-sm p-1" title="Xóa tất cả giỏ hàng" onclick="return confirm('Bạn có chắc muốn xóa tất cả sản phẩm trong giỏ hàng?');" style="border-radius: 6px; line-height: 1;">
                                <img src="@Url.Content("~/Images/remove.png")" alt="Xóa tất cả" style="height: 18px; width: 18px;" />
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><img src="@item.ProductImage" alt="@item.ProductName" style="max-height:80px;" /></td>
                            <td class="col-md-3">
                                <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })" style="text-decoration:none;">
                                    @item.ProductName
                                </a>
                            </td>
                            <td>
                                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                                {
                                    <input type="hidden" name="id" value="@item.ProductID" />
                                    <button type="button" style="width: 24px;" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity - 1)">-</button>
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="100" style="width: 50px; text-align:right;" onchange="cartUpdateQuantity(@item.ProductID, this.value)" />
                                    <button type="button" style="width: 24px;" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity + 1)">+</button>
                                }
                            </td>
                            <td>@item.UnitPrice.ToString("N0") đ</td>
                            <td class="text-danger fw-bold">@item.TotalPrice.ToString("N0") đ</td>
                            <td class="text-center" style="width: 50px;">
                                <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="btn btn-outline-danger btn-sm p-1" title="Xóa sản phẩm này" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');" style="border-radius: 6px; line-height: 1;">
                                    <img src="@Url.Content("~/Images/remove.png")" alt="Xóa" style="height: 18px; width: 18px;" />
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <hr />
        </div>

        <div class="col-md-3 cart-section" style="border: 1px solid #E8DFD8; border-radius: 12px; padding: 18px;">
            <div><strong>Tổng giá trị: &nbsp;<span style="color: #B45309; font-size: 1.25rem;">@Model.TotalValue().ToString("N0") đ</span></strong></div>
            <div class="mt-3">
                <a href="@Url.Action("Checkout", "Order")" class="btn text-white w-100 py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #B45309 0%, #78350F 100%); border: none; border-radius: 8px;">
                    Thanh toán (Mua hàng)
                </a>
            </div>
        </div>
    }
</div>
<div class="col-md-12 mt-3">
    <a href="@Url.Action("Index", "Home")" class="btn px-4 py-2 fw-semibold" style="background: #ffffff; color: #5D4037; border: 1px solid #8D6E63; border-radius: 8px;">
        ← Tiếp tục mua hàng
    </a>
</div>
