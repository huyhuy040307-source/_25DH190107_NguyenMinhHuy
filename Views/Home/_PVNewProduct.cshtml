@model _25DH190025_NguyenHuynhHongQuan.Models.ViewModel.HomeProductVM
@using PagedList.Mvc;

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css?v=@DateTime.Now.Ticks" />
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="container-fluid listProduct">
        <h2>Sản phẩm mới</h2>
        <ul class="list-container">
            @foreach (var product in Model.NewProducts)
            {
                <li class="lproduct-item">
                    <div class="prod-img-box">
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Html.DisplayFor(modelItem => product.ProductImage)" alt="@product.ProductName" />
                        </a>
                    </div>
                    <div class="prod-info-box">
                        <div class="prod-details-group">
                            <p class="prodPrice">@product.ProductPrice.ToString("N0") đ</p>
                            <p class="prodName">
                                <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })" title="@product.ProductName">
                                    @Html.DisplayFor(modelItem => product.ProductName)
                                </a>
                            </p>
                            <p class="prodCate">
                                @(product.Category != null ? product.Category.CategoryName : "Sách")
                            </p>
                            <p class="prodSale">
                                Đã bán: @(product.SoldQuantity > 0 ? product.SoldQuantity : product.OrderDetails.Count) &nbsp;|&nbsp; Tồn: @product.Quantity
                            </p>
                        </div>
                        <div class="prod-actions">
                            <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })" class="btn btn-outline-primary btn-sm flex-fill">Chi tiết</a>
                            <a href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID, quantity = 1 })" class="btn btn-danger btn-sm flex-fill">Mua ngay</a>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </section>

    <div class="pagination-container">
        @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new
        {
            page,
            searchTerm = Model.SearchTerm
        }))
    </div>
}
else
{
    <p>Không tìm được sản phẩm nào phù hợp.</p>
}
