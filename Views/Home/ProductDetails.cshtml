@model _25DH190025_NguyenHuynhHongQuan.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/myStyle/CustomerDetailProduct.css" rel="stylesheet" />

<div class="container-fluid pro">
    <div class="div-horizontal">
        @* Khối bên trái *@
        <div class="col-md-3 pro-section pro-image">
            <img src="@Model.product.ProductImage" />
        </div>

        @* Khối ở giữa *@
        <div class="col-md-5 pro-section">
            <div>
                <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>
                <p class="pro-sale">
                    Đã bán:&nbsp; @(Model.product.SoldQuantity > 0 ? Model.product.SoldQuantity : Model.product.OrderDetails.Count)
                    &nbsp;|&nbsp;
                    Số lượng tồn:&nbsp; <strong>@Model.product.Quantity</strong>
                </p>
                <p class="pro-price">@Model.product.ProductPrice.ToString("N0") VNĐ</p>
                <p>Danh mục:&nbsp;@Model.product.Category.CategoryName</p>
                <hr />
                <h5><strong>Mô tả</strong></h5>
                <p>@Model.product.ProductDescription</p>
            </div>
            <hr />
            <div>@Html.Partial("_PVRelatedProduct", Model)</div>
        </div>

        @* Khối bên phải *@
        <div class="col-md-3 pro-section">
            <div class="form-group">
                <form action="@Url.Action("ProductDetails", "Home")" method="get">
                    <input type="hidden" name="id" value="@Model.product.ProductID" />
                    <h4><strong>Số lượng</strong></h4>
                    <p>
                        @Html.TextBoxFor(model => model.quantity, new
                        {
                            @class = "form-control",
                            @type = "number",
                            @min = 1,
                            @max = Model.product.Quantity > 0 ? Model.product.Quantity : 1,
                            onchange = "this.form.submit()"
                        })
                    </p>

                    <h4><strong>Tạm tính</strong></h4>
                    <p class="fw-bold fs-5" style="color: #B45309;">@Model.estimatedValue.ToString("N0") VNĐ</p>

                    @if (Model.product.Quantity > 0)
                    {
                        <p>
                            @Html.ActionLink("🛒 Thêm vào giỏ hàng", "AddToCart", "Cart",
                                new { id = Model.product.ProductID, quantity = Model.quantity },
                                new { @class = "btn text-white w-100 fw-bold shadow-sm", style = "background: linear-gradient(135deg, #B45309 0%, #78350F 100%); border: none; padding: 10px; border-radius: 8px;" })
                        </p>
                    }
                    else
                    {
                        <p class="badge bg-danger">Sản phẩm tạm hết hàng</p>
                    }
                </form>
                <hr />
            </div>
            <div>@Html.Partial("_PVTopProduct", Model)</div>
        </div>
    </div>
</div>
